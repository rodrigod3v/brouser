# ============================================================================
# BROUSER — configuracao via ambiente
# Copie:  cp .env.example .env   (NUNCA commite o .env real)
# Onde pegar cada key: comentarios inline abaixo
# ============================================================================

# ----------------------------------------------------------------------------
# LLM PRINCIPAL (provider OpenAI-compatible)
# ----------------------------------------------------------------------------
# Qualquer endpoint compativel com /chat/completions funciona.
# Exemplos de base URL:
#   OpenAI.......: https://api.openai.com/v1
#   OpenRouter...: https://openrouter.ai/api/v1
#   OpenCode Zen.: https://opencode.ai/zen/v1        <- mesmas keys do opencode
#   Ollama local.: http://localhost:11434/v1
#   Groq.........: https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=coloque-sua-key-aqui

# Modelo padrao (tier pago / forte). Ex.: gpt-4o-mini, claude-sonnet, qwen3-coder
LLM_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# TIER GRATUITO (opcional) — usado por --model free ou router auto
# ----------------------------------------------------------------------------
# Aponte para um provider com modelos free (OpenRouter free, opencode free, etc)
LLM_FREE_BASE_URL=
LLM_FREE_API_KEY=
LLM_FREE_MODEL=

# Roteamento de modelo: auto | free | paid
#   auto = comeca no free; escala pro paid se falhar/estagnar
#   free = sempre free (erro se nao configurado)
#   paid = sempre pago
MODEL_ROUTING=auto

# ----------------------------------------------------------------------------
# JEV / TypeSafe (julgamentos deterministicos baratos)
# ----------------------------------------------------------------------------
# Usado para: gate de acoes sensiveis + verificacao de conclusao de tarefa
# DUAS opcoes de backend:
#   a) TypeSafe cloud: key em https://console.typesafe.ai/
#      TYPESAFE_API_KEY=tsk-...  JEV_BASE_URL=https://api.typesafe.ai  JEV_MODEL=jev-latest
#   b) OpenCode Zen (mesma key oc_sk_ do opencode!):
#      TYPESAFE_API_KEY=oc_sk_...  JEV_BASE_URL=https://opencode.ai/zen  JEV_MODEL=jev-1.13-free
# NOTA: base_url SEM /v1 no fim — o SDK ja adiciona /v1/systemone
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Desliga o gate de risco (true/false). Default: true (gate ligado)
JEV_GATE_ENABLED=true
# Segunda opiniao do Jev antes de aceitar action=done (true/false)
JEV_VERIFY_DONE=false

# ----------------------------------------------------------------------------
# BROWSER
# ----------------------------------------------------------------------------
# headless=true roda sem janela (CI/servidor). Default: false (voce ve o browser)
BROUSER_HEADLESS=false
# Canal do browser: chromium (bundled) | chrome | msedge
BROUSER_CHANNEL=chromium
# Timeout de navegacao em ms
BROUSER_NAV_TIMEOUT_MS=30000
# Maximo de elementos interativos enviados ao LLM por step
BROUSER_MAX_ELEMENTS=80

# ----------------------------------------------------------------------------
# AGENTE
# ----------------------------------------------------------------------------
# Limite de steps por tarefa (protecao contra loop infinito/custo)
BROUSER_MAX_STEPS=25
# Diretorio de perfil persistente do Chromium (cookies/login sobrevivem)
# Vazio = perfil temporario por sessao
BROUSER_PROFILE_DIR=.brouser/profile

# ----------------------------------------------------------------------------
# OBSIDIAN (memoria das sessoes)
# ----------------------------------------------------------------------------
# Caminho do vault Brain-Brouser. Cada sessao vira uma nota em sessions/
BROUSER_OBSIDIAN_VAULT=C:\Users\777\Documents\Obsidian\Brain-Brouser
# Desliga persistencia (true/false). Default: false (persiste)
BROUSER_MEMORY_DISABLED=false

# ----------------------------------------------------------------------------
# SKILLS (find-skills / npx skills)
# ----------------------------------------------------------------------------
# Permite o agente sugerir/instalar skills via `npx skills` (true/false)
BROUSER_SKILLS_ENABLED=true
